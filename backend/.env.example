# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/msgly

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@msgly.com

# Account Configuration
ACCOUNT_DELETION_GRACE_DAYS=30

# Server Configuration
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Firebase Configuration (Path or Base64)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-adminsdk.json

# Optional: Sentry for Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# Logging
LOG_LEVEL=info
